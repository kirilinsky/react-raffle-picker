{
  "name": "react-raffle-picker",
  "version": "0.4.0",
  "description": "React random picker: draw a random winner or number with slot-machine, reel and countdown animations. Headless, typed, zero-dependency.",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirilinsky/react-raffle-picker.git"
  },
  "bugs": {
    "url": "https://github.com/kirilinsky/react-raffle-picker/issues"
  },
  "homepage": "https://react-raffle-one.vercel.app/",
  "scripts": {
    "build": "tsdown && cp src/styles.css dist/styles.css",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "format": "prettier --write src",
    "knip": "knip",
    "publint": "publint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "keywords": [
    "react",
    "random-picker",
    "random-name-picker",
    "name-picker",
    "winner-picker",
    "random-winner",
    "giveaway",
    "giveaway-picker",
    "prize-draw",
    "raffle",
    "raffle-picker",
    "lottery",
    "slot-machine",
    "slot-machine-react",
    "reel",
    "number-picker",
    "random-number",
    "countdown",
    "headless",
    "headless-ui",
    "compound-components",
    "react-component",
    "typescript"
  ],
  "author": "Kirilinsky (https://github.com/kirilinsky)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/js": "^9.0.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "eslint": "^9.2.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.3.5",
    "jsdom": "^29.0.2",
    "knip": "^5.40.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "publint": "^0.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "storybook": "^10.3.5",
    "tsdown": "^0.21.8",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "volta": {
    "node": "22.12.0"
  }
}
